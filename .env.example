# Copy to .env if it does not exist. Never commit .env.
# Local Oracle Free setup: see README.md. Use raw values without quotes.
ORACLE_USER=atb
# Set the application-user password chosen during bootstrap.
ORACLE_PASSWORD=
ORACLE_DSN=localhost:1521/FREEPDB1
# For Autonomous DB, replace user/DSN with your user and wallet TNS alias or full connect string.
# Folder of the unzipped wallet (Autonomous DB). Leave blank for a local/free container DB.
ORACLE_WALLET_DIR=
ORACLE_WALLET_PASSWORD=
# Not needed by the local app or its hashing-vector policy fallback.
OPENAI_API_KEY=

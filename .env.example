# Copy to .env and fill in at the event. Never commit .env.
ORACLE_USER=ADMIN
ORACLE_PASSWORD=
# Autonomous DB: the TNS alias from the wallet's tnsnames.ora (e.g. mydb_high), or a full connect string
ORACLE_DSN=
# Folder of the unzipped wallet (Autonomous DB). Leave blank for a local/free container DB.
ORACLE_WALLET_DIR=
ORACLE_WALLET_PASSWORD=
OPENAI_API_KEY=
